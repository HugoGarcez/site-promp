{
    "providers": [
        "node"
    ],
    "phases": {
        "setup": {
            "nixPkgs": [
                "nodejs-20_x",
                "npm"
            ]
        },
        "install": {
            "cmds": [
                "npm ci"
            ]
        },
        "build": {
            "cmds": [
                "npm run build"
            ]
        }
    },
    "start": {
        "cmd": "node .output/server/index.mjs"
    }
}