# ==============================================================================
# CONFIGURAÇÃO DE INTEGRAÇÃO WHATSAPP (UAZAPI) • PROMP BLOG
# ==============================================================================

# URL da sua instância UAzapi (pode ser a URL base ou a rota completa /send/text)
# Exemplo: https://sua-instancia.uazapi.com/send/text
UAZAPI_URL="https://api.uazapi.com/send/text"

# Token da instância UAzapi (fornecido no painel da sua instância)
UAZAPI_TOKEN="seu_token_aqui"

# Número de WhatsApp que receberá a notificação de novo artigo publicado (com DDI e DDD)
# Exemplo: 5511999999999 ou 5521987654321
UAZAPI_NUMBER="5511999999999"

# ==============================================================================
# ALIASES COMPATÍVEIS (opcional)
# ==============================================================================
# WHATSAPP_API_URL=""
# WHATSAPP_API_KEY=""
# WHATSAPP_NOTIFY_NUMBER=""
